<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>

		<!-- Login universal Reserva2App — funciona en cualquier instancia SQL Server -->
		<add name="ServicioDB"
			 connectionString="Data Source=localhost;Initial Catalog=Reserva2_Servicio;User ID=Reserva2App;Password=R2#App2026!;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient"/>
		<add name="NegocioDB"
			 connectionString="Data Source=localhost;Initial Catalog=Reserva2_Negocio;User ID=Reserva2App;Password=R2#App2026!;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient"/>
		<add name="MasterDB"
			 connectionString="Data Source=localhost;Initial Catalog=master;User ID=Reserva2App;Password=R2#App2026!;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient"/>

	</connectionStrings>
	<appSettings>
	  <add key="I18NFolder" value="I18n"/>
	  <add key="I18NFileName" value="idioma"/>
	</appSettings>
</configuration>